# ===== AgentScope-AP 环境变量模板 =====
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会入库。

# ---- 模型凭据（至少配置一个，Agent 才能跑起来）----
# 通义千问 / DashScope
DASHSCOPE_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=

# ---- PostgreSQL 主库 ----
POSTGRES_USER=ap
POSTGRES_PASSWORD=ap_password
POSTGRES_DB=agentscope_ap
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 组装后的异步连接串（SQLAlchemy + asyncpg）
DATABASE_URL=postgresql+asyncpg://ap:ap_password@localhost:5432/agentscope_ap

# ---- Redis（缓存 / 分布式锁 / MessageBus）----
# 注意：本机 6379 被 Windows 原生 Redis 占用，docker 映射到 6380
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- 运行角色与可回滚后端 ----
SERVICE_ROLE=api
VECTOR_BACKEND=milvus
BLOB_BACKEND=s3
WORKSPACE_BACKEND=local

# ---- Qdrant / Milvus 向量库 ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:root
MILVUS_ROOT_PASSWORD=root
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX

# ---- 本地 Blob / MinIO（S3 兼容对象存储）----
BLOB_DIR=./blobs
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ap_minio
S3_SECRET_KEY=ap_minio_password
S3_BUCKET=ap-knowledge
S3_REGION=us-east-1

# ---- 平台认证（阶段2）----
# true=强制 JWT（阶段2）；false=透传 X-User-ID（阶段1本地快速验证）
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# ---- HTTP 与精确 CORS ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-User-ID,X-Request-ID

# ---- 可选：MCP / Skill Hub ----
# 高德 MCP（可选）
AMAP_API_KEY=
# ClawHub token（可选，仅提高 Skill Hub 限流）
CLAWHUB_API_TOKEN=
